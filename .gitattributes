# Keep text portable and binary CAD exports byte-identical.
* text=auto eol=lf
*.stp -text -diff
*.step -text -diff
*.SLDPRT binary
*.SLDASM binary
*.stl binary
*.3mf binary
*.onnx binary
*.png binary
*.jpg binary
*.gif binary
*.mp4 binary

# Preserve the exact slicer snapshots and audit bytes used by the A1 mini hashes.
hardware/printable/wamoduck-a1mini-standing/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
hardware/printable/wamoduck-a1mini-standing/slicing/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
hardware/printable/wamoduck-a1mini-standing/source/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
